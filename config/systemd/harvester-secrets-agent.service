[Unit]
Description=harvester-ops, secret store agent (OpenBao, closed list of operations)
Documentation=file:///opt/harvester-ops/docs/en/install.md

[Service]
Type=oneshot
# Root on the host: the console never is. Runs the request the console left
# in /var/lib/harvester-ops/secrets-agent/request.json (closed list of
# operations, see the script), or, started by harvester-secrets-rotate.timer
# without a request, rotates the console secret_id once it is 30 days old
# and prunes the kept volumes and retired unseal keys.
# install.sh replaces the interpreter with a verified host Python >= 3.9.
ExecStart=/usr/bin/python3 /usr/local/bin/harvester-secrets-agent.py
TimeoutStartSec=30min
UMask=0077
