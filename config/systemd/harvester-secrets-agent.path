[Unit]
Description=harvester-ops, watch for a secret store request from the console

[Path]
# The console (unprivileged container) drops this file to ask for an
# operation on the OpenBao secret store (deposit of a wrapped secret_id,
# B1 install, rotations, snapshot restore); the agent removes it first
# thing, so the path does not trigger again.
PathExists=/var/lib/harvester-ops/secrets-agent/request.json
Unit=harvester-secrets-agent.service

[Install]
WantedBy=multi-user.target
