[Unit]
Description=harvester-ops, daily secret store housekeeping (secret_id rotation every 30 days)

[Timer]
# Daily run of the agent without a request: it rotates the console
# secret_id when it is 30 days old (point 260), and prunes what it keeps.
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
Unit=harvester-secrets-agent.service

[Install]
WantedBy=timers.target
