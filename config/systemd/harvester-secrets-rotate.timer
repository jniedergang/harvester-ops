[Unit]
Description=harvester-ops, hourly secret store housekeeping (secret_id rotation every 30 days, health)

[Timer]
# Hourly run of the agent without a request: it rotates the console
# secret_id when it is 30 days old (point 260), and prunes what it keeps.
OnCalendar=hourly
RandomizedDelaySec=10min
Persistent=true
Unit=harvester-secrets-agent.service

[Install]
WantedBy=timers.target
